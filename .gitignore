node_modules/

# Certs (regenerated per machine via `npm run gen-cert`) — never commit private keys
server/certs/
python/certs/

# Python
.venv/
venv/
__pycache__/
*.pyc

# Build output
dist/
build/
desktop/release/
*.zip

# Misc
.DS_Store
*.log
.env

# Office temp / lock files (e.g. ~$REPORT.docx, created while a doc is open in Word)
~$*

# Personal interview-prep notes — never push
interview.md

# Generated documentation (doc/generate_doc.py regenerates these; the script IS committed)
doc/*.docx
doc/assets/

# NOTE: the top-level assets/ folder (README images) IS committed on purpose — do not ignore it.
# Regenerate those with assets/generate_assets.py.

# Interop toolchain + Go target (downloaded, never committed)
.tooling/
interop/target/webtransport-go/
interop/**/*.exe
interop/**/certs/
interop/**/*.pem
*.captures.json
